{
  "manifest_version": 3,
  "name": "Paper & Honey",
  "description": "A warm paper theme for Thunderbird: cream and espresso, brown ink, honey accents.",
  "version": "0.5.1",
  "author": "Paul Welty",
  "homepage_url": "https://paulwelty.com/apps/paper-and-honey/",
  "icons": {
    "32": "icon.svg",
    "64": "icon.svg"
  },
