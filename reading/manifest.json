{
  "manifest_version": 3,
  "name": "Paper & Honey Reading",
  "description": "The recommended companion to the Paper & Honey theme: plain-text mail in Charter with room to breathe, and a compose window that matches.",
  "version": "0.5.0",
  "author": "Paul Welty",
  "homepage_url": "https://paulwelty.com/apps/paper-and-honey/",
  "browser_specific_settings": {
    "gecko": {
      "id": "paper-and-honey-reading@paulwelty.com",
      "strict_min_version": "151.0",
      "update_url": "https://paulwelty.com/apps/paper-and-honey/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "messagesModify",
    "compose"
  ],
  "message_display_scripts": [
    {
      "css": [
        "reading.css"
      ]
    }
  ],
  "compose_scripts": [
    {
      "css": [
        "compose.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
